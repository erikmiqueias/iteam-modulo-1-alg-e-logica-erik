Algoritmo "Ex01"

Var
  precoUnitario: real
  i: inteiro

Inicio

  precoUnitario <- 18.5 // inicia a variável com o preço inicial

  para i de 1 ate 10 faca // inicia o incrementador com 1
    escreval(i, " caderno = R$", precoUnitario * i) // multiplica o preço unitário por ex: 18.5 x 1 = 18.5; 18.5 x 2 = 37.0...
  fimpara

fimalgoritmo
