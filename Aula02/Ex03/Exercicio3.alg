Algoritmo "Exercicio3"


// Autor(a): Erik Miqueias Pereira Costa
// Data: 03/08/2026

Var
// Seção de Declarações das variáveis
numero: inteiro


Inicio
// Seção de Comandos
escreval("Digite um número: ");
leia(numero); // armazena o número dado pelo usuário na variavel numero
escreva("O dobro do número: ", numero, " é ", numero * 2); // exibi o dobro do valor



fimalgoritmo