Algoritmo "Exercicio2"

// Autor(a): Erik Miqueias Pereira Costa
// Data: 03/08/2026

Var
// Seção de Declarações das variáveis
nome: caractere

Inicio
// Seção de Comandos
// Ler o nome do usuário
escreva("Digite seu nome: ")
leia(nome)
escreva("Olá ", nome, " seja bem vindo!") // Exibir mensagem de boas vindas



fimalgoritmo