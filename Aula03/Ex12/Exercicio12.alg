Algoritmo "Exercicio12"


// Autor(a): Erik Miqueias Pereira Costa
// Data: 03/08/2026

Var
// Seção de Declarações das variáveis
i: inteiro

Inicio
// Seção de Comandos
	para i de 10 ate 1 passo -1 faca // decrementa -1 a cada loop
  	escreva(i, " ");
 	fimpara
  escreva("Feliz ano novo!"); // após o fim do loop mostra a mensagem


fimalgoritmo