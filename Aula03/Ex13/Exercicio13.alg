Algoritmo "Exercicio13"

// Autor(a): Erik Miqueias Pereira Costa
// Data: 03/08/2026

Var
// Seção de Declarações das variáveis
i: inteiro

Inicio
// Seção de Comandos
	para i de 0 ate 100 faca
  	se i % 2 = 0 entao // verifica a cada loop se o incrementador é divisel por 2 resto 0, se for é par
    	escreva(i, " ")
    fimse
  fimpara


fimalgoritmo