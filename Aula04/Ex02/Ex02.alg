Algoritmo "Ex02"
// Nome do (a) aluno: Erik Miqueias Pereira Costa
// Data: 06/08/2026

Var
  qtdEstoque: inteiro

Inicio

  escreval("Digite a quantidade de estoque: ")
  leia(qtdEstoque)

  se qtdEstoque <= 10 entao
    escreva("Reposição necessária!")
  senao
    escreva("Estoque suficiente")
  fimse
  
fimalgoritmo
